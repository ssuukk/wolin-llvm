package pl.qus.wolin

// raster interrupt colour band taken from:
// https://gist.github.com/bremensaki/8f33cd7d67b78377881c7eb7147c0f32

import c64.vic.*
import c64.cia.*

var interruptRoutineVector: uword^0x314 // this is C64 raster interrupt vector
var cia1InerruptCtrlReg: ubyte^0xDC0D
var i: ubyte
var maskInterrupts: bool^CPU.I

// Sprite 0 pointer ($07F8): block 192 -> data at 192 * 64 = $3000, where
// sprite0Shape below is initialised.
var sprite0Pointer: ubyte^2040

// A 1-color hot air balloon (sprite 0), 21 rows x 3 bytes (B0 B1 B2) at
// $3000. Element i -> index i; the rest of the 256-byte array stays zero.
// B2 = 0 on every row keeps it in 1-color mode (spriteColor0 tints it).
// Columns 1-24 map to bits 128..1 across B0, B1 and B2.
var sprite0Shape: ubyte[ubyte]^0x3000 = [
    0b00000000, 0b11111110, 0b00000000,
    0b00000011, 0b11111111, 0b10000000,
    0b00000111, 0b11111111, 0b11000000,
    0b00000111, 0b11001111, 0b11000000,
    0b00001111, 0b10110011, 0b11100000,
    0b00001111, 0b10111111, 0b11100000,
    0b00001111, 0b10110011, 0b11100000,
    0b00000111, 0b11001111, 0b11000000,
    0b00000111, 0b11111111, 0b11000000,
    0b00000111, 0b11111111, 0b11000000,
    0b00000101, 0b11111111, 0b01000000,
    0b00000010, 0b11111110, 0b10000000,
    0b00000010, 0b01111100, 0b10000000,
    0b00000001, 0b00111001, 0b00000000,
    0b00000001, 0b00111001, 0b00000000,
    0b00000000, 0b10010010, 0b00000000,
    0b00000000, 0b10010010, 0b00000000,
    0b00000000, 0b01111100, 0b00000000,
    0b00000000, 0b01111100, 0b00000000,
    0b00000000, 0b01111100, 0b00000000,
    0b00000000, 0b00111000, 0b00000000
]

fun onRasterGoto(line: ubyte, proc: uword) {
    interruptRoutineVector = proc
    rasterCounter = line
}

/*********************************************************
* Raster bar
**********************************************************/
interrupt fun backgroundToBlue() {
    onRasterGoto(140, backgroundToWhite)
    borderColor = Color.BLUE
    backgroundColor0 = Color.BLUE
    interruptStatus = 0xff // a 1 clears the flag, so write them all
    return@0xea31
}

interrupt fun backgroundToWhite() {
    onRasterGoto(160, backgroundToBlue)
    borderColor = Color.WHITE
    backgroundColor0 = Color.WHITE
    interruptStatus = 0xff
    return@0xea31
}

fun rasterBar() {
    borderColor = Color.BLUE
    backgroundColor0 = Color.BLUE
    interruptEnable := InterruptSource.RASTER
    controlRegister1 .= Control1.RST8 // High bit of raster line cleared, we're only working within single byte ranges
    onRasterGoto(140, backgroundToBlue)
}

/*********************************************************
* Open border
**********************************************************/

interrupt fun topRoutine() {
    controlRegister1 := Control1.RSEL // 25 rows
    onRasterGoto(0xf9, bottomRoutine)
    interruptStatus = 0xff
    return@0xea31
}

interrupt fun bottomRoutine() {
    controlRegister1 .= Control1.RSEL // 24 rows
    onRasterGoto(0xff, topRoutine)
    interruptStatus = 0xff // at line ff set to 25 rows
    return@0xea31
}

fun openBorder() {
    spriteEnable := SpriteMask.SPRITE0
    spriteXExpansion := SpriteMask.SPRITE0
    spriteYExpansion := SpriteMask.SPRITE0
    sprite0X = 100
    sprite0Y = 30
    spriteColor0 = Color.BLACK // black, like the source balloon
    sprite0Pointer = 192 // block 0xC0 -> sprite 0 shape at $3000
    backgroundColor0 = Color.YELLOW
    borderColor = Color.BLUE

    interruptEnable := InterruptSource.RASTER // Enable raster interrupts
    controlRegister1 .= Control1.RST8 // High bit of raster line cleared, we're only working within single byte ranges
    onRasterGoto(0xf9, bottomRoutine)
}

/*********************************************************
* Main function
**********************************************************/

fun main() {
    maskInterrupts = true // Suspend interrupts during init
    cia1InterruptControl = 0x7f // Disable CIA

    //rasterBar()
    openBorder()

    maskInterrupts = false

    do {
        i++
    } while (i<255)

}
