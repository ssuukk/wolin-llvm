package c64.vic

// VIC-II (MOS 6567/6569) register map, $d000-$d02f.
//
// Each name is a fixed-address `ubyte` window on one register: a read
// fetches the register, a write stores it. The registers repeat every
// 64 bytes in $d000-$d3ff (incomplete address decoding); these point at
// the canonical $d000 block.
//
// $d01f and $d020 are read-only on the hardware (cleared on read), so they
// are declared `val`. Bit notes per Bauer's VIC-II paper (zimmers.net).

// --- Sprites 0-7: coordinates ---

// X/Y coordinate of each sprite; the X low byte's bit 8 lives in
// spriteXHigh.
var sprite0X: ubyte^0xd000
var sprite0Y: ubyte^0xd001
var sprite1X: ubyte^0xd002
var sprite1Y: ubyte^0xd003
var sprite2X: ubyte^0xd004
var sprite2Y: ubyte^0xd005
var sprite3X: ubyte^0xd006
var sprite3Y: ubyte^0xd007
var sprite4X: ubyte^0xd008
var sprite4Y: ubyte^0xd009
var sprite5X: ubyte^0xd00a
var sprite5Y: ubyte^0xd00b
var sprite6X: ubyte^0xd00c
var sprite6Y: ubyte^0xd00d
var sprite7X: ubyte^0xd00e
var sprite7Y: ubyte^0xd00f

// Bit 8 (MSB) of each sprite's X coordinate; bit 7-n is sprite n.
var spriteXHigh: ubyte^0xd010

// Control 1: bit 7 RST8 (bit 8 of the raster comparison line), 6 ECM, 5 BMM,
// 4 DEN, 3 RSEL, 2-0 YSCROLL.
var controlRegister1: ubyte^0xd011

// Raster counter: the current raster line (0-255); bit 8 is RST8 in
// controlRegister1. A write to these two registers sets the raster
// interrupt comparison line.
var rasterCounter: ubyte^0xd012

// Light pen position, latched on a negative edge of the light pen line.
var lightPenX: ubyte^0xd013
var lightPenY: ubyte^0xd014

// Sprites 0-7 enabled; bit 7-n is sprite n.
var spriteEnable: ubyte^0xd015

// Control 2: bit 5 RES (no function on the 6567/6569), 4 MCM, 3 CSEL, 2-0
// XSCROLL.
var controlRegister2: ubyte^0xd016

// Sprites 0-7 Y expansion (doubled height); bit 7-n is sprite n.
var spriteYExpansion: ubyte^0xd017

// Screen address pointer: screenAddressHigh holds bits 13-10 of the screen
// address (its bits 7-4) and bits 13-11 of the color address (its bits 3-1);
// screenAddressLow holds the low byte of the screen address.
var screenAddressHigh: ubyte^0xd018

// Interrupt status (IRQST): bit 7 IRQ (master; writing 0 clears the flag),
// 4 ILP (light pen), 3 IMMC (sprite-sprite collision), 2 IMBC
// (sprite-background collision), 1 IRST (raster line).
var interruptStatus: ubyte^0xd019

// Interrupt enable (IRQEN): bit 1 ERST (raster interrupt); the other bits
// gate the light pen, sprite-sprite and sprite-background sources. Write 1 to
// enable a source, 0 to disable it.
var interruptEnable: ubyte^0xd01a

// Sprites 0-7 above the background (data priority); bit 7-n is sprite n.
var spriteDataPriority: ubyte^0xd01b

// Sprites 0-7 multicolor; bit 7-n is sprite n.
var spriteMulticolor: ubyte^0xd01c

// Sprites 0-7 X expansion (doubled width); bit 7-n is sprite n.
var spriteXExpansion: ubyte^0xd01d

// Sprites 0-7 collided with another sprite; read-only, cleared on read.
val spriteSpriteCollision: ubyte^0xd01e

// Sprites 0-7 collided with background data; read-only, cleared on read.
val spriteBackgroundCollision: ubyte^0xd01f

// --- Colors: a 4-bit palette value in bits 3-0 (0 black, 1 white, 2 red,
// 3 cyan, 4 pink, 5 green, 6 blue, 7 yellow, 8 orange, 9 brown, 10 light
// red, 11 dark gray, 12 medium gray, 13 light green, 14 light blue,
// 15 light gray) ---

// Border color.
var borderColor: ubyte^0xd020

// Background colors 0-3.
var backgroundColor0: ubyte^0xd021
var backgroundColor1: ubyte^0xd022
var backgroundColor2: ubyte^0xd023
var backgroundColor3: ubyte^0xd024

// Multicolor background colors 0-1 (the background pair in multicolor
// bitmap mode).
var multicolorBackground0: ubyte^0xd025
var multicolorBackground1: ubyte^0xd026

// Sprites 0-7 colors.
var spriteColor0: ubyte^0xd027
var spriteColor1: ubyte^0xd028
var spriteColor2: ubyte^0xd029
var spriteColor3: ubyte^0xd02a
var spriteColor4: ubyte^0xd02b
var spriteColor5: ubyte^0xd02c
var spriteColor6: ubyte^0xd02d
var spriteColor7: ubyte^0xd02e

// --- Enums ---

// The 16 VIC-II palette values, in bits 3-0 of every colour register:
// border, background 0-3, the multicolor background pair, sprite 0-7 and
// the sprite colour pair of multicolor sprites.
//
// A colour register holds the value in its low nibble; the upper nibble is
// unused and reads back as 1, so a read has to be masked with 0x0f.
// `Color` is a ubyte alias, so it can be written straight into a colour
// register or used as an index.
enum Color {
    BLACK = 0,
    WHITE = 1,
    RED = 2,
    CYAN = 3,
    PINK = 4,
    GREEN = 5,
    BLUE = 6,
    YELLOW = 7,
    ORANGE = 8,
    BROWN = 9,
    LIGHT_RED = 10,
    DARK_GRAY = 11,
    MEDIUM_GRAY = 12,
    LIGHT_GREEN = 13,
    LIGHT_BLUE = 14,
    LIGHT_GRAY = 15
}

// A sprite mask: bit 7-n selects sprite n. The same mask goes into
// spriteEnable, spriteDataPriority, spriteMulticolor, spriteXExpansion
// and spriteYExpansion; spriteXHigh uses bit n instead of bit 7-n.
//
// A mask is built by ORing the bits of the sprites in it, so the values are
// single-bit masks to be combined, not numbers to store.
enum SpriteMask {
    SPRITE0 = 0x80,
    SPRITE1 = 0x40,
    SPRITE2 = 0x20,
    SPRITE3 = 0x10,
    SPRITE4 = 0x08,
    SPRITE5 = 0x04,
    SPRITE6 = 0x02,
    SPRITE7 = 0x01
}

// The interrupt sources of interruptEnable (IRQEN): bit 1 ERST (raster),
// bit 2 EMBC (sprite-background), bit 3 EMMC (sprite-sprite). Write the bit
// to enable a source, 0 to disable it.
//
// The register has only those three bits on the 6567/6569: the light pen
// interrupt (bit 4, ELP) was dropped with the light pen, and the other
// bits are not implemented and read back as 1. A read therefore has to be
// masked with 0x0e.
enum InterruptSource {
    SPRITE_COLLISION = 0x08,
    SPRITE_BACKGROUND = 0x04,
    RASTER = 0x02
}

// The interrupt flags of interruptStatus (IRQST): bit 1 IRST (raster),
// bit 2 IMBC (sprite-background), bit 3 IMMC (sprite-sprite), bit 7 IRQ
// (the master flag; writing 0 clears it).
//
// The flag bits and the enable bits are the same positions: a raster
// interrupt is bit 1 in both registers, and the collision sources are bits
// 2 and 3 in both. Only IRQ (bit 7, the master flag) is unique to the
// status register.
//
// The light pen flag (bit 4, ILP) was dropped with the light pen; like the
// unimplemented enable bits, it reads back as 1.
enum InterruptFlag {
    IRQ = 0x80,
    SPRITE_COLLISION = 0x08,
    SPRITE_BACKGROUND = 0x04,
    RASTER = 0x02
}

// The bits of controlRegister1 ($d011): bit 7 RST8 (the high bit of the
// raster comparison line), bit 6 ECM (external colour matrix), bit 5 BMM
// (bitmap mode), bit 4 DEN (display enable), bits 3-1 RSEL (the row
// select), bits 2-0 YSCROLL (the fine vertical scroll).
//
// Bit 7 is the high bit of the raster comparison line, and the register is
// only 8 bits wide on a 6567, so the bit is not implemented and reads 1.
// Mask it off (0x7f) when the other bits are what matters.
enum Control1 {
    RST8 = 0x80,
    ECM = 0x40,
    BMM = 0x20,
    DEN = 0x10,
    RSEL = 0x08,
    YSCROLL = 0x07
}

// The bits of controlRegister2 ($d016): bit 5 RES (unused on the
// 6567/6569), bit 4 MCM (multicolour mode), bit 3 CSEL (the column
// select), bits 2-0 XSCROLL (the fine horizontal scroll).
enum Control2 {
    RES = 0x20,
    MCM = 0x10,
    CSEL = 0x08,
    XSCROLL = 0x07
}
